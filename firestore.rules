rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function owner() {
      return signedIn() && request.auth.uid == 'hDbzbNTC7pOuU2UFCjFksopbgaG3';
    }

    function isActiveAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }

    // Owner and authorized active administrators check
    function isAuthorizedNotesUser() {
      return owner() || isActiveAdmin();
    }

    // Admins collection: Only the owner can authorize or revoke administrators
    match /admins/{adminUid} {
      allow read: if owner() || (signedIn() && request.auth.uid == adminUid);
      allow create, update, delete: if owner();
    }

    // PIN verifier records: Each user can only read and write their own security record
    match /userSecurity/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid && isAuthorizedNotesUser();
    }

    // Private owner-only and admin notes: Deny everyone else completely
    match /privateNotes/{noteId} {
      allow read, write: if isAuthorizedNotesUser();
    }

    // Users collection for general site visitors
    match /users/{uid} {
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.approved == false;
      allow read: if signedIn() && (request.auth.uid == uid || owner());
      allow update: if owner() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['approved']);
      allow delete: if owner();
    }

    // Access requests collection
    match /accessRequests/{requestId} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read: if owner() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update: if owner();
      allow delete: if owner();
    }
  }
}
