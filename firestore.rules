rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function verifiedAccount() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    function owner() {
      return signedIn()
        && request.auth.uid == 'hDbzbNTC7pOuU2UFCjFksopbgaG3';
    }

    function authorizedNotesUser() {
      // The original Notes collection is exclusively the owner's application.
      // User-to-user administration belongs in separate per-user storage.
      return owner();
    }

    function validYourNote(data) {
      return data.keys().hasOnly(['title', 'content', 'createdAt', 'updatedAt', 'protection', 'deletionStatus', 'deletedAt'])
        && data.updatedAt == request.time
        && ((!('protection' in data) || data.protection == null)
          && data.title is string
          && data.title.size() <= 160
          && data.content is string
          && data.content.size() <= 20000
          || data.protection is map
          && data.protection.keys().hasOnly(['version', 'saltHex', 'ivHex', 'ciphertextHex'])
          && data.protection.keys().hasAll(['version', 'saltHex', 'ivHex', 'ciphertextHex'])
          && data.protection.version == 1
          && data.protection.saltHex is string
          && data.protection.saltHex.matches('^[0-9a-fA-F]{32}$')
          && data.protection.ivHex is string
          && data.protection.ivHex.matches('^[0-9a-fA-F]{24}$')
          && data.protection.ciphertextHex is string
          && data.protection.ciphertextHex.matches('^[0-9a-fA-F]+$')
          && data.protection.ciphertextHex.size() >= 32
          && data.protection.ciphertextHex.size() <= 200000
          && data.title == 'Protected note'
          && data.content == '');
    }

    function personalAccountActive(userUid) {
      return !exists(/databases/$(database)/documents/yourNotes/$(userUid))
        || get(/databases/$(database)/documents/yourNotes/$(userUid)).data.deletionStatus == 'active';
    }

    function applicationPermissionActive(userUid, appName) {
      return exists(/databases/$(database)/documents/applicationPermissions/$(userUid))
        && get(/databases/$(database)/documents/applicationPermissions/$(userUid)).data[appName] == 'active';
    }

    function personalDeletionReady(userUid) {
      return exists(/databases/$(database)/documents/yourNotes/$(userUid))
        && get(/databases/$(database)/documents/yourNotes/$(userUid)).data.deletionStatus == 'ready';
    }

    function validNoteTrashTransition(data) {
      return data.keys().hasOnly(['title', 'content', 'createdAt', 'updatedAt', 'protection', 'deletionStatus', 'deletedAt'])
        && data.updatedAt == request.time
        && data.createdAt == resource.data.createdAt
        && data.deletedAt == request.time
        && data.deletionStatus == 'trashed';
    }

    function validDeletionSchedule() {
      return request.resource.data.keys().hasOnly([
          'deletionStatus', 'deletionRequestedAt', 'deletionAt'
        ])
        && request.resource.data.deletionStatus == 'scheduled'
        && request.resource.data.deletionRequestedAt == request.time
        && request.resource.data.deletionAt > request.time
        && request.resource.data.deletionAt <= request.time + duration.value(30, 'd')
        && request.resource.data.deletionAt >= request.time + duration.value(29, 'd');
    }

    function validDeletionCancellation() {
      return resource.data.deletionStatus == 'scheduled'
        && resource.data.deletionAt > request.time
        && request.resource.data.keys().hasOnly([
          'deletionStatus', 'deletionRequestedAt', 'deletionAt', 'deletionCancelledAt'
        ])
        && request.resource.data.deletionStatus == 'active'
        && request.resource.data.deletionRequestedAt == resource.data.deletionRequestedAt
        && request.resource.data.deletionAt == resource.data.deletionAt
        && request.resource.data.deletionCancelledAt == request.time;
    }

    function validDeletionReadyTransition() {
      return resource.data.deletionStatus == 'scheduled'
        && resource.data.deletionAt <= request.time
        && request.resource.data.keys().hasOnly([
          'deletionStatus', 'deletionRequestedAt', 'deletionAt', 'deletionReadyAt'
        ])
        && request.resource.data.deletionStatus == 'ready'
        && request.resource.data.deletionRequestedAt == resource.data.deletionRequestedAt
        && request.resource.data.deletionAt == resource.data.deletionAt
        && request.resource.data.deletionReadyAt == request.time;
    }

    // ADMINISTRATORS
    // Only the owner can create, activate, deactivate or delete admins.
    // An administrator can read only their own admin record.
    match /admins/{adminUid} {
      allow read: if owner()
        || (signedIn() && request.auth.uid == adminUid);

      allow create, update, delete: if owner();
    }

    // SHARED NOTES SECURITY CONFIGURATION
    // Salt, password hash metadata and versioning.
    // Only the owner can read or modify the owner's Notes gate configuration.
    match /notesConfig/{configId} {
      allow read: if owner();
      allow write: if owner();
    }

    // ACTIVE NOTES SESSIONS
    // Only a trusted Admin SDK backend may issue or revoke session records.
    match /activeNotesSessions/{sessionUid} {
      allow read: if signedIn() && (request.auth.uid == sessionUid || owner());
      allow write: if false;
    }

    // INVITATIONS
    // Single-use, cryptographically random FJ invitation tokens.
    // Only the owner can view, create or revoke invitation records.
    match /invitations/{inviteHash} {
      allow read, write: if owner();
    }

    // PRIVATE NOTES
    // Owner-only private Notes. The owner identity remains the actual database boundary.
    match /privateNotes/{noteId} {
      allow read, create, update, delete: if authorizedNotesUser()
        && exists(/databases/$(database)/documents/activeNotesSessions/$(request.auth.uid))
        && get(/databases/$(database)/documents/activeNotesSessions/$(request.auth.uid)).data.uid == request.auth.uid
        && get(/databases/$(database)/documents/activeNotesSessions/$(request.auth.uid)).data.revoked == false
        && get(/databases/$(database)/documents/activeNotesSessions/$(request.auth.uid)).data.expiresAt > request.time;
    }

    // OLD PIN RECORDS
    // The PIN system is retired. No client may read or write these records.
    match /userSecurity/{uid} {
      allow read, write: if false;
    }

    // USER ACCOUNTS
    // A user may create only their own unapproved profile.
    // Only the trusted owner/admin backend may approve an account.
    match /users/{uid} {

      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
          'email',
          'approved',
          'createdAt'
        ])
        && request.resource.data.approved == false;

      allow read: if signedIn()
        && (request.auth.uid == uid || owner());

      allow update: if owner()
        && request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(['approved']);

      allow delete: if owner();
    }

    // ACCESS REQUESTS
    // Users can submit pending requests and read their own requests.
    // Only the owner can review, approve, reject or delete requests.
    match /accessRequests/{requestId} {

      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly([
          'uid',
          'email',
          'status',
          'deliveryStatus',
          'createdAt'
        ])
        && request.resource.data.deliveryStatus == 'pending';

      allow read: if owner()
        || (signedIn() && resource.data.uid == request.auth.uid);

      allow update: if owner()
        && request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly([
            'status',
            'reviewedAt',
            'reviewedBy',
            'deliveryStatus',
            'deliveryTimestamp',
            'error'
          ]);

      allow delete: if owner();
    }

    // Independent application permissions are owner-managed and read-only to the account.
    match /applicationPermissions/{userUid} {
      allow read: if verifiedAccount() && (request.auth.uid == userUid || owner());
      allow create, update, delete: if owner();
    }

    // Account lifecycle is separate from notes. Scheduling suspends note access;
    // cancellation is allowed only during the 30-day grace period.
    match /yourNotes/{userUid} {
      allow read: if verifiedAccount() && request.auth.uid == userUid;
      allow create: if verifiedAccount()
        && request.auth.uid == userUid
        && validDeletionSchedule();
      allow update: if verifiedAccount()
        && request.auth.uid == userUid
        && (validDeletionCancellation()
            || validDeletionReadyTransition()
            || (resource.data.deletionStatus == 'active' && validDeletionSchedule()));
      allow delete: if verifiedAccount()
        && request.auth.uid == userUid
        && personalDeletionReady(userUid);
    }

    // Each Your Notes user has a separate UID-scoped private notes tree.
    // No client can list another account's data or promote itself through note fields.
    match /yourNotes/{userUid}/notes/{noteId} {
      allow read: if verifiedAccount()
        && request.auth.uid == userUid
        && applicationPermissionActive(userUid, 'notesStatus')
        && (personalAccountActive(userUid) || personalDeletionReady(userUid));
      allow delete: if verifiedAccount()
        && request.auth.uid == userUid
        && applicationPermissionActive(userUid, 'notesStatus')
        && (personalAccountActive(userUid) || personalDeletionReady(userUid));
      allow create: if verifiedAccount()
        && request.auth.uid == userUid
        && applicationPermissionActive(userUid, 'notesStatus')
        && personalAccountActive(userUid)
        && validYourNote(request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow update: if verifiedAccount()
        && request.auth.uid == userUid
        && applicationPermissionActive(userUid, 'notesStatus')
        && personalAccountActive(userUid)
        && validYourNote(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && (validNoteTrashTransition(request.resource.data)
            || (resource.data.deletionStatus == 'trashed'
                && request.resource.data.deletionStatus == 'active'
                && request.resource.data.deletedAt == null
                && request.resource.data.updatedAt == request.time)
            || (!('deletionStatus' in request.resource.data)
                && !('deletedAt' in request.resource.data)));
    }

    match /yourNotes/{userUid}/notes/{noteId}/attachments/{attachmentId} {
      allow read, delete: if verifiedAccount()
        && request.auth.uid == userUid
        && applicationPermissionActive(userUid, 'notesStatus')
        && personalAccountActive(userUid);
      allow create: if verifiedAccount()
        && request.auth.uid == userUid
        && applicationPermissionActive(userUid, 'notesStatus')
        && personalAccountActive(userUid)
        && request.resource.data.keys().hasOnly(['name', 'type', 'size', 'dataUrl', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 180
        && request.resource.data.type is string
        && request.resource.data.type.matches('^(image|text|application)/[^,]{1,180}$')
        && request.resource.data.size is int
        && request.resource.data.size >= 0
        && request.resource.data.size <= 1000000
        && request.resource.data.dataUrl is string
        && request.resource.data.dataUrl.size() <= 1400000
        && request.resource.data.createdAt == request.time;
    }

    // All other collections and documents are denied by default.
  }
}
