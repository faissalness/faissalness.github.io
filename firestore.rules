rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function verifiedAccount() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    function owner() {
      return signedIn()
        && request.auth.uid == 'hDbzbNTC7pOuU2UFCjFksopbgaG3';
    }

    function authorizedNotesUser() {
      // The original Notes collection is exclusively the owner's application.
      // User-to-user administration belongs in separate per-user storage.
      return owner();
    }

    function validYourNote(data) {
      return data.keys().hasOnly(['title', 'content', 'createdAt', 'updatedAt'])
        && data.title is string
        && data.title.size() <= 160
        && data.content is string
        && data.content.size() <= 20000
        && data.updatedAt == request.time;
    }

    // ADMINISTRATORS
    // Only the owner can create, activate, deactivate or delete admins.
    // An administrator can read only their own admin record.
    match /admins/{adminUid} {
      allow read: if owner()
        || (signedIn() && request.auth.uid == adminUid);

      allow create, update, delete: if owner();
    }

    // SHARED NOTES SECURITY CONFIGURATION
    // Salt, password hash metadata and versioning.
    // Only the owner can read or modify the owner's Notes gate configuration.
    match /notesConfig/{configId} {
      allow read: if owner();
      allow write: if owner();
    }

    // ACTIVE NOTES SESSIONS
    // Only a trusted Admin SDK backend may issue or revoke session records.
    match /activeNotesSessions/{sessionUid} {
      allow read: if signedIn() && (request.auth.uid == sessionUid || owner());
      allow write: if false;
    }

    // INVITATIONS
    // Single-use, cryptographically random FJ invitation tokens.
    // Only the owner can view, create or revoke invitation records.
    match /invitations/{inviteHash} {
      allow read, write: if owner();
    }

    // PRIVATE NOTES
    // Owner-only private Notes. The owner identity remains the actual database boundary.
    match /privateNotes/{noteId} {
      allow read, create, update, delete: if authorizedNotesUser()
        && exists(/databases/$(database)/documents/activeNotesSessions/$(request.auth.uid))
        && get(/databases/$(database)/documents/activeNotesSessions/$(request.auth.uid)).data.uid == request.auth.uid
        && get(/databases/$(database)/documents/activeNotesSessions/$(request.auth.uid)).data.revoked == false
        && get(/databases/$(database)/documents/activeNotesSessions/$(request.auth.uid)).data.expiresAt > request.time;
    }

    // OLD PIN RECORDS
    // The PIN system is retired. No client may read or write these records.
    match /userSecurity/{uid} {
      allow read, write: if false;
    }

    // USER ACCOUNTS
    // A user may create only their own unapproved profile.
    // Only the owner may approve or remove users.
    match /users/{uid} {

      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
          'email',
          'approved',
          'createdAt'
        ])
        && request.resource.data.approved == false;

      allow read: if signedIn()
        && (request.auth.uid == uid || owner());

      allow update: if owner()
        && request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(['approved']);

      allow delete: if owner();
    }

    // ACCESS REQUESTS
    // Users can submit pending requests and read their own requests.
    // Only the owner can review, approve, reject or delete requests.
    match /accessRequests/{requestId} {

      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly([
          'uid',
          'email',
          'status',
          'createdAt'
        ]);

      allow read: if owner()
        || (signedIn() && resource.data.uid == request.auth.uid);

      allow update: if owner()
        && request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly([
            'status',
            'reviewedAt'
          ]);

      allow delete: if owner();
    }

    // Each Your Notes user has a separate UID-scoped private notes tree.
    // No client can list another account's data or promote itself through note fields.
    match /yourNotes/{userUid}/notes/{noteId} {
      allow read, delete: if verifiedAccount() && request.auth.uid == userUid;
      allow create: if verifiedAccount()
        && request.auth.uid == userUid
        && validYourNote(request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow update: if verifiedAccount()
        && request.auth.uid == userUid
        && validYourNote(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    // All other collections and documents are denied by default.
  }
}
